<resources>
    <!-- "Night marquee" palette: deep indigo hero panel with a warm marquee-gold accent,
         on a cream dashboard - evokes old cinema-hall signage without leaning on cliché
         AI-default colors. Chosen deliberately as fixed values (not theme-dependent) so
         contrast never breaks under system light/dark mode. -->
    <color name="ink">#1B1533</color>
    <color name="ink_light">#2E2650</color>
    <color name="marquee_gold">#F2B705</color>
    <color name="cream">#FBF7F0</color>
    <color name="card_cream">#FFFFFF</color>
    <color name="charcoal">#2B2630</color>
    <color name="mauve">#8A7A99</color>
    <color name="tag_bg">#EFE9F7</color>
    <color name="tag_text">#5B4B79</color>
</resources>
